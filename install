#!/usr/bin/env zsh

0=${${(M)${0::=${(%):-%x}}:#/*}:-$PWD/$0}

builtin emulate -L zsh -o extendedglob -o noshortloops \
                        -o warncreateglobal -o typesetsilent \
                        -o nopromptsubst

typeset -g DOTFILEDIR=$(cd "$(dirname "$0")"; pwd)

function link_conf() {
  local source="$1"
  local target="$2"

  if [ -e "$target" ]; then
    echo -e "\t\e[3mSkipping ${target}\e[0m"
    return
  fi
  [ -d "$(dirname "$target")" ] || mkdir -p "$(dirname "$target")"

  echo -e "\tLinking ${target}"
  ln -s "$source" "$target"
}

function copy_conf() {
  local source="$1"
  local target="$2"

  if [ -e "$target" ]; then
    echo -e "\t\e[3mSkipping ${target}\e[0m"
    return
  fi
  [ -d "$(dirname "$target")" ] || mkdir -p "$(dirname "$target")"

  echo -e "\tCopying ${target}"
  cp "$source" "$target"
}

function git_clone() {
  local source="$1"
  local target="$2"

  if [ -e "$target" ]; then
    echo -e "\t\e[3mSkipping ${target}\e[0m"
    return
  fi
  [ -d "$(dirname "$target")" ] || mkdir -p "$(dirname "$target")"

  echo -e "\tCloning ${target}"
  git clone --quiet --depth 1 "$source" "$target"
}

function http_get() {
  local source="$1"
  local target="$2"

  if [ -e "$target" ]; then
    echo -e "\t\e[3mSkipping ${target}\e[0m"
    return
  fi
  [ -d "$(dirname "$target")" ] || mkdir -p "$(dirname "$target")"

  echo -e "\tDownloading ${target}"
  curl -fqsSL -o "${target}" "${source}"
}

function ensure_homebrew() {
  [[ -e /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"

  if command -v brew >/dev/null 2>&1; then
    return 0
  fi

  echo "The brew command was not found."
  read -q "?Do you want to install it? " || return -1
  print ''
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" || return 1
  [[ -e /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"
  command -v brew >/dev/null 2>&1
}

function ensure_package_installed() {
  local command="$1"
  local package="${2:-${command}}"

  case "$(uname -s)" in
    Darwin)
      ensure_homebrew || return 1
      if ! command -v "${command}" >/dev/null 2>&1; then
        echo "The ${package} homebrew package is not installed."
        read -q "?Do you want to install it? " || return -1
        print ''
        brew install "${package}" || return 1
        rehash
      fi
      command -v "${command}" >/dev/null 2>&1
      ;;
    *)
      if ! command -v "${command}" >/dev/null 2>&1; then
        echo "${command} is required but was not found on your path." >&2
        echo "Please install the ${package} package manually and rerun ./install." >&2
        return 1
      fi
      ;;
  esac
}

function install_module() {
  readonly module="${1}"
  readonly install_script="${DOTFILEDIR}/${module}/install.zsh"

  echo "Installing ${module} module"

  if [ ! -e "${install_script}" ]; then
            echo "No such module: ${module}"
            exit 1
  fi

  source "${install_script}" "$(dirname "${install_script}")"
}

function install() {
  local -a modules_to_install
  local dir module

  if (($# == 0)); then
    for dir in "${DOTFILEDIR}"/*/install.zsh; do
      modules_to_install+=("$(basename "$(dirname "$dir")")")
    done
  else
    modules_to_install+=("$@")
  fi

  for module in "${modules_to_install[@]}"; do
    if ! install_module "${module}"; then
      echo "Failed to install ${module} module" >&2
      exit 1
    fi
  done
}

install "$@"
